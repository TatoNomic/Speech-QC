    const targetSr = this._pcm.targetSr;
    const samples = (Math.abs(ctxSr - targetSr) < 1) ? flat : resampleLinear(flat, ctxSr, targetSr);

    const wav = encodeWav(samples, targetSr);
    const blob = new Blob([wav], { type: 'audio/wav' });
    const report = this._finaliseRecording();
    report.format = 'wav_pcm16';
    report.sample_rate_hz = targetSr;
    report.context_sample_rate_hz = ctxSr;
    report.resampled = (Math.abs(ctxSr - targetSr) >= 1);
    report.pcm_samples = samples.length;

    this.mode = 'monitoring';
    this._pcm = null;
    if (this._pcmResolve) {
      this._pcmResolve({ blob: blob, report: report });
      this._pcmResolve = null;
    }
  };

  GladAudioQC.prototype.stop = async function () {
    this.mode = 'idle';
    if (this.recorder && this.recorder.state === 'recording') {
      this.recorder.stop();
    }
    if (this._pcm && this._pcm.active) {
      // abort PCM capture without producing a blob
      this._pcm.active = false;
      try { this.worklet.port.postMessage({ type: 'captureRaw', on: false }); } catch (e) {}
      this._pcm = null;
      if (this._pcmResolve) {
        this._pcmResolve({ blob: null, report: null, aborted: true });
        this._pcmResolve = null;
      }
    }
    try {
      if (this.source) this.source.disconnect();
      if (this.worklet) this.worklet.disconnect();
      if (this.silentGain) this.silentGain.disconnect();
      if (this.stream) this.stream.getTracks().forEach(function (t) { t.stop(); });
      if (this.ctx && this.ctx.state !== 'closed') await this.ctx.close();
    } catch (e) { /* already closed */ }
    this.ctx = null;
    this.stream = null;
    this.source = null;
    this.worklet = null;
    this.silentGain = null;
    this.calibrated = false;
  };

  GladAudioQC.prototype.getMetrics = function () {
    const noise = this.noise.current;
    const signal = this.speech.current;
    const snr = signal === null ? null : signal - noise;
    return {
      noiseFloorDbfs: noise,
      signalDbfs: signal,
      snrDb: snr,
      verdict: snr === null ? null : this._classify(snr),
      mode: this.mode,
      calibrated: this.calibrated,
      info: this._info || null
    };
  };

  GladAudioQC.prototype.getReport = function () {
    const m = this.getMetrics();
    return {
      snr_db: m.snrDb === null ? null : Number(m.snrDb.toFixed(2)),
      noise_floor_dbfs: Number(m.noiseFloorDbfs.toFixed(2)),
      signal_dbfs: m.signalDbfs === null ? null : Number(m.signalDbfs.toFixed(2)),
      verdict: m.verdict,
      sample_rate_hz: m.info ? m.info.sampleRate : null,
      calibrated: m.calibrated,
      user_agent: navigator.userAgent
    };
  };

  // Warm-up state for the host UI / Qualtrics gate. Until
  // monitoring_warmed_up is true, the verdict the engine is computing
  // is based on too few confirmed-voiced frames to be meaningful and
  // the host should suppress its display. The engine continues to
  // compute and emit verdicts; gating is the host's responsibility.
  GladAudioQC.prototype.getMonitoringState = function () {
    const required = this.opts.thresholds.warmupFrames;
    const confirmed = this._confirmedVoicedFrames;
    return {
      confirmed_voiced_frames: confirmed,
      monitoring_warmed_up: confirmed >= required,
      warmup_frames_required: required
    };
  };

  /* ---------- device / platform metadata ----------
   * Returns { platform, microphone, track_settings }, populated from
   * navigator.userAgent, MediaStreamTrack.getSettings(), and
   * navigator.mediaDevices.enumerateDevices(). Async because
   * enumerateDevices() returns a Promise.
   *
   * Must be called after init() (i.e. mic permission granted), since
   * enumerateDevices returns empty labels otherwise. Safe to call
   * multiple times. Never throws — missing string fields return
   * 'unknown', missing numeric/boolean fields return null.
   * ----------------------------------------------------------------- */
  GladAudioQC.prototype.getDeviceInfo = async function () {
    const ua = (typeof navigator !== 'undefined' && navigator.userAgent) || '';
    const os = detectOS(ua);
    const browser = detectBrowser(ua);
    const deviceClass = detectDeviceClass(ua);

    let micLabel = 'unknown';
    let micDeviceId = 'unknown';
    let sampleRate = null;
    let channelCount = null;
    let echoCancellation = null;
    let noiseSuppression = null;
    let autoGainControl = null;

    if (this.stream) {
      const tracks = this.stream.getAudioTracks();
      if (tracks.length > 0) {
        try {
          const settings = (typeof tracks[0].getSettings === 'function')
            ? tracks[0].getSettings() : null;
          if (settings) {
            if (typeof settings.sampleRate === 'number') sampleRate = settings.sampleRate;
            if (typeof settings.channelCount === 'number') channelCount = settings.channelCount;
            if (typeof settings.echoCancellation === 'boolean') echoCancellation = settings.echoCancellation;
            if (typeof settings.noiseSuppression === 'boolean') noiseSuppression = settings.noiseSuppression;
            if (typeof settings.autoGainControl === 'boolean') autoGainControl = settings.autoGainControl;
            if (settings.deviceId) micDeviceId = settings.deviceId;
          }
        } catch (e) { /* sub-API unavailable; leave as defaults */ }

        try {
          if (navigator.mediaDevices && typeof navigator.mediaDevices.enumerateDevices === 'function') {
            const devices = await navigator.mediaDevices.enumerateDevices();
            let matched = null;
            for (let i = 0; i < devices.length; i++) {
              if (devices[i].kind === 'audioinput' && devices[i].deviceId === micDeviceId) {
                matched = devices[i]; break;
              }
            }
            if (!matched) {
              for (let i = 0; i < devices.length; i++) {
                if (devices[i].kind === 'audioinput') { matched = devices[i]; break; }
              }
            }
            if (matched) {
              if (matched.label) micLabel = matched.label;
              if ((micDeviceId === 'unknown' || !micDeviceId) && matched.deviceId) {
                micDeviceId = matched.deviceId;
              }
            }
          }
        } catch (e) { /* enumerateDevices unavailable; leave as defaults */ }
      }
    }

    const micCategory = classifyMicLabel(micLabel === 'unknown' ? '' : micLabel, deviceClass);

    return {
      platform: {
        user_agent: ua || 'unknown',
        os: os,
        browser: browser,
        device_class: deviceClass
      },
      microphone: {
        label: micLabel,
        category: micCategory,
        device_id: micDeviceId
      },
      track_settings: {
        sample_rate: sampleRate,
        channel_count: channelCount,
        echo_cancellation: echoCancellation,
        noise_suppression: noiseSuppression,
        auto_gain_control: autoGainControl
      }
    };
  };

  /* ---------- internal ---------- */

  GladAudioQC.prototype._onRaw = function (block) {
    if (this._pcm && this._pcm.active) {
      this._pcm.chunks.push(block);
      this._pcm.totalSamples += block.length;
    }
  };

  GladAudioQC.prototype._onFrame = function (frame) {
    this._frameCount++;
    this._latestFrame = frame;
    const thr = this.opts.thresholds;

    const rms = rmsDbfs(frame);
    const pk = peakDbfs(frame);
    const isClipped = clippedFrame(frame, thr.clipSampleThr, thr.clipRunMin);

    let flatness = null;
    if (this._frameCount % 2 === 0) flatness = spectralFlatness(frame);

    if (this.mode === 'calibrating') {
      this.noise.calibrate(rms);
      if (performance.now() - this._calibStart >= this.opts.calibrationMs) {
        this.calibrated = true;
        this.mode = 'monitoring';
        // Reset run-length / warm-up state at the calibration→monitoring
        // transition (calibrate auto-promotes to monitoring without
        // going through start()).
        this._voicedRun = 0;
        this._confirmedVoicedFrames = 0;
        if (this.opts.onCalibrated) this.opts.onCalibrated({ noiseFloorDbfs: this.noise.current });
        if (this._calibResolve) { this._calibResolve(); this._calibResolve = null; }
      }
      this._emit(rms, pk, null, null, isClipped);
      return;
    }

    const energyAboveNoise = rms - this.noise.current;
    const isVoiced =
      energyAboveNoise > thr.vadEnergyDb &&
      (flatness === null ? true : flatness < thr.vadFlatMax);

    // Run-length gate. A frame counts as confirmed-voiced only after
    // vadMinRunFrames consecutive isVoiced classifications. Three states:
    //   - !isVoiced               → noise tracker updates
    //   - isVoiced & not yet run  → neither tracker updates (transient)
    //   - confirmed-voiced        → speech tracker updates
    // Skipping ambiguous frames in BOTH trackers keeps the noise floor
    // stable when speech is just beginning, and keeps the speech EMA
    // clean of HVAC clicks / body movements / one-off transients.
    if (isVoiced) {
      this._voicedRun++;
    } else {
      this._voicedRun = 0;
    }
    const isConfirmedVoiced = this._voicedRun >= thr.vadMinRunFrames;

    if (isConfirmedVoiced) {
      this.speech.update(rms);
      this._confirmedVoicedFrames++;
    } else if (!isVoiced) {
      this.noise.update(rms);
    }

    if (isClipped && this.opts.onClipping) this.opts.onClipping(this._frameCount);

    if (this._rec && this.recorder && this.recorder.state === 'recording') {
      this._rec.totalFrames++;
      if (isClipped) this._rec.clipFrames++;
      // voiced_pct in the report now means "confirmed-voiced fraction"
      // (sustained voicing), not raw per-frame voiced — this is the
      // correct value for downstream QC and matches the warm-up gate.
      if (isConfirmedVoiced) this._rec.voicedFrames++;
      if (pk > this._rec.peak) this._rec.peak = pk;
      if (this.speech.current !== null) {
        this._rec.snrs.push(this.speech.current - this.noise.current);
      }
    }

    this._emit(rms, pk, isVoiced, isConfirmedVoiced, isClipped);
  };

  GladAudioQC.prototype._emit = function (rms, pk, isVoiced, isConfirmedVoiced, isClipped) {
    const now = performance.now();
    if (now - this._lastEmit < this.opts.uiThrottleMs) return;
    this._lastEmit = now;

    const noise = this.noise.current;
    const signal = this.speech.current;
    const snr = signal === null ? null : signal - noise;
    const verdict = snr === null ? null : this._classify(snr);

    if (this.opts.onFrame) {
      this.opts.onFrame({
        frameIndex: this._frameCount,
        rmsDbfs: rms,
        peakDbfs: pk,
        noiseFloor: noise,
        signalLevel: signal,
        snr: snr,
        isVoiced: isVoiced,
        isConfirmedVoiced: isConfirmedVoiced,
        isClipped: isClipped,
        verdict: verdict,
        latestFrame: this._latestFrame
      });
    }
    if (this.opts.onVerdict && verdict !== null) {
      this.opts.onVerdict({ level: verdict, snr: snr });
    }
  };

  GladAudioQC.prototype._classify = function (snr) {
    if (snr >= this.opts.thresholds.snrGood) return 'good';
    if (snr >= this.opts.thresholds.snrWarn) return 'warn';
    return 'bad';
  };

  GladAudioQC.prototype._finaliseRecording = function () {
    const r = this._rec;
    const thr = this.opts.thresholds;
    const durSec = (performance.now() - r.startedAt) / 1000;
    const meanSnr = r.snrs.length
      ? r.snrs.reduce(function (a, b) { return a + b; }, 0) / r.snrs.length
      : null;
    const clipPct = r.totalFrames ? (r.clipFrames / r.totalFrames) * 100 : 0;
    const voicedPct = r.totalFrames ? (r.voicedFrames / r.totalFrames) * 100 : 0;

    const reasons = [];
    if (durSec < thr.minDurationSec) reasons.push('too_short');
    if (clipPct > thr.maxClipPct) reasons.push('clipping');
    if (voicedPct < thr.minVoicedPct) reasons.push('insufficient_speech');
    if (meanSnr !== null && meanSnr < thr.snrWarn) reasons.push('low_snr');

    let verdict;
    if (reasons.length === 0 && meanSnr !== null && meanSnr >= thr.snrGood) verdict = 'pass';
    else if (reasons.length === 0) verdict = 'ok';
    else verdict = 'fail';

    this._rec = null;
    return {
      duration_sec: Number(durSec.toFixed(2)),
      mean_snr_db: meanSnr === null ? null : Number(meanSnr.toFixed(2)),
      clipped_pct: Number(clipPct.toFixed(3)),
      voiced_pct: Number(voicedPct.toFixed(2)),
      peak_dbfs: Number(r.peak.toFixed(2)),
      verdict: verdict,
      fail_reasons: reasons,
      sample_rate_hz: this._info ? this._info.sampleRate : null,
      user_agent: navigator.userAgent,
      recorded_at_iso: new Date().toISOString(),
      device_info: r.deviceInfo || null
    };
  };

  GladAudioQC.prototype._err = function (msg) {
    if (this.opts.onError) this.opts.onError(msg);
  };

  // expose helpers for advanced callers
  GladAudioQC.dsp = {
    rmsDbfs: rmsDbfs,
    peakDbfs: peakDbfs,
    spectralFlatness: spectralFlatness,
    clippedFrame: clippedFrame,
    resampleLinear: resampleLinear,
    encodeWav: encodeWav,
    NoiseTracker: NoiseTracker,
    SpeechTracker: SpeechTracker,
    detectOS: detectOS,
    detectBrowser: detectBrowser,
    detectDeviceClass: detectDeviceClass,
    classifyMicLabel: classifyMicLabel
  };

  return GladAudioQC;
}));


Qualtrics.SurveyEngine.addOnReady(async function() {


    const qContainer = this.getQuestionContainer();

    // ----------------------------------------------------------
    // STEP 1 — UI + Disable Next
    // ----------------------------------------------------------
    this.hideNextButton();

    qContainer.innerHTML += `
        <div id="qc-status" style="margin-top:10px; font-weight:bold; font-family: monospace;">
            Initialising microphone...
        </div>
        <button id="qc-retry" style="margin-top:10px; display:none;">Retry</button>
    `;

    const statusEl = qContainer.querySelector("#qc-status");
    const retryBtn = qContainer.querySelector("#qc-retry");

    let attempt = 0;

    // ----------------------------------------------------------
    // STEP 2 — MAIN QC FUNCTION
    // ----------------------------------------------------------
    const runQC = async () => {

        retryBtn.style.display = "none";
        this.hideNextButton();

        attempt += 1;
        Qualtrics.SurveyEngine.setEmbeddedData("qc_attempt", attempt);

        // ----------------------------------------------------------
        // STEP 3 — Check QC library
        // ----------------------------------------------------------
        if (typeof GladAudioQC === "undefined") {
            console.error("GladAudioQC not loaded");
            statusEl.innerHTML = "QC library not loaded";
            return;
        }

        // ----------------------------------------------------------
        // STEP 4 — QC instance
        // ----------------------------------------------------------
        const qc = new GladAudioQC({
            thresholds: {
                snrGood: 20,
                snrWarn: 15
            },
            onError: function(err) {
                console.error(err);
                statusEl.innerHTML = "Microphone error: " + err;
            }
        });

        // ----------------------------------------------------------
        // STEP 5 — Init mic + DEVICE INFO
        // ----------------------------------------------------------
        let deviceInfo = null;

        try {
            await qc.init();
            statusEl.innerHTML = "Microphone ready";

            try {
                deviceInfo = await qc.getDeviceInfo();
            } catch (e) {
                console.warn("Device info not available");
            }

        } catch (err) {
            statusEl.innerHTML = "Microphone access denied";
            return;
        }

        // ----------------------------------------------------------
        // STEP 6 — Calibration
        // ----------------------------------------------------------
        statusEl.innerHTML = "Calibrating... please stay silent";
        try {
            await qc.calibrate();
        } catch (err) {
            statusEl.innerHTML = "Calibration failed";
            return;
        }

        // ----------------------------------------------------------
        // STEP 7 — Recording
        // ----------------------------------------------------------
        statusEl.innerHTML = "Recording... please speak briefly";

        let result;

        try {
            result = await qc.record(10000);
        } catch (err) {
            statusEl.innerHTML = "Recording failed";
            return;
        }

        // ----------------------------------------------------------
        // STEP 8 — Extract report
        // ----------------------------------------------------------
        const report = result.report || {};

        console.log("FULL QC REPORT:", report);

        Qualtrics.SurveyEngine.setEmbeddedData("qc_report_json", JSON.stringify(report));
        Qualtrics.SurveyEngine.setEmbeddedData("qc_snr", report.mean_snr_db);
        Qualtrics.SurveyEngine.setEmbeddedData("qc_duration", report.duration_sec);
        Qualtrics.SurveyEngine.setEmbeddedData("qc_voiced_pct", report.voiced_pct);
        Qualtrics.SurveyEngine.setEmbeddedData("qc_clipped_pct", report.clipped_pct);
        Qualtrics.SurveyEngine.setEmbeddedData("qc_engine_verdict", report.verdict);

        // ✅ DEVICE METADATA
        if (deviceInfo) {

            Qualtrics.SurveyEngine.setEmbeddedData("qc_device_os", deviceInfo.os || "");
            Qualtrics.SurveyEngine.setEmbeddedData("qc_device_browser", deviceInfo.browser || "");
            Qualtrics.SurveyEngine.setEmbeddedData("qc_device_class", deviceInfo.device_class || "");

            if (deviceInfo.microphone) {
                Qualtrics.SurveyEngine.setEmbeddedData("qc_mic_label", deviceInfo.microphone.label || "");
                Qualtrics.SurveyEngine.setEmbeddedData("qc_mic_category", deviceInfo.microphone.category || "");
            }

            if (deviceInfo.track_settings) {
                Qualtrics.SurveyEngine.setEmbeddedData("qc_sample_rate", deviceInfo.track_settings.sampleRate || "");
                Qualtrics.SurveyEngine.setEmbeddedData("qc_channel_count", deviceInfo.track_settings.channelCount || "");
                Qualtrics.SurveyEngine.setEmbeddedData("qc_echo_cancellation", deviceInfo.track_settings.echoCancellation || "");
                Qualtrics.SurveyEngine.setEmbeddedData("qc_noise_suppression", deviceInfo.track_settings.noiseSuppression || "");
                Qualtrics.SurveyEngine.setEmbeddedData("qc_auto_gain_control", deviceInfo.track_settings.autoGainControl || "");
            }
        }

        const snr = Number(report.mean_snr_db);
        const voiced = Number(report.voiced_pct);
        const clipped = Number(report.clipped_pct);
        const duration = Number(report.duration_sec);

        // ----------------------------------------------------------
        // ✅ STEP 9 — CALIBRATION QC LOGIC (FIXED)
        // ----------------------------------------------------------
        let pass = true;
        let reasons = [];

        // ❗ PRIMARY: ENVIRONMENT QUALITY
        if (!snr || isNaN(snr) || snr < 20) {
            pass = false;
            reasons.push("low SNR (noisy environment)");
        }

        // ❗ SECONDARY: MIC CHECK ONLY (very loose)
        if (!voiced || voiced < 5) {
            pass = false;
            reasons.push("no speech detected (mic issue)");
        }

        // ❗ OPTIONAL: sanity check
        if (!duration || duration < 5) {
            pass = false;
            reasons.push("too short");
        }

        // ❗ clipping still valid
        if (!isNaN(clipped) && clipped > 2) {
            pass = false;
            reasons.push("clipping");
        }

        if (!pass && reasons.length === 0) {
            reasons.push("unknown");
        }

        // ✅ store
        Qualtrics.SurveyEngine.setEmbeddedData("qc_pass", pass ? "1" : "0");
        Qualtrics.SurveyEngine.setEmbeddedData("qc_fail_reasons", reasons.join(", "));

        // ----------------------------------------------------------
        // STEP 10 — DEBUG OUTPUT
        // ----------------------------------------------------------
        var debugText = "QC DEBUG:\n";
        debugText += "duration_sec: " + report.duration_sec + "\n";
        debugText += "voiced_pct: " + report.voiced_pct + "\n";
        debugText += "mean_snr_db: " + report.mean_snr_db + "\n";
        debugText += "clipped_pct: " + report.clipped_pct + "\n";
        debugText += "engine_verdict: " + report.verdict + "\n";

        // ----------------------------------------------------------
        // STEP 11 — DISPLAY
        // ----------------------------------------------------------
        statusEl.innerHTML =
            (pass ? "✅ Environment check passed<br>" : "❌ Environment check failed<br>") +
            "SNR: " + report.mean_snr_db + " dB<br><br>" +
            "<pre>" + debugText + "</pre>";

        if (pass) {
            this.showNextButton();
        } else {
            retryBtn.style.display = "inline-block";
        }
    };

    // ----------------------------------------------------------
    // STEP 12 — Retry
    // ----------------------------------------------------------
    retryBtn.addEventListener("click", () => {
        runQC();
    });
	
	

    // ----------------------------------------------------------
    // STEP 13 — First run
    // ----------------------------------------------------------
    runQC();

});